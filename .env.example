# Copy to .env — every value maps to Settings in src/ontoforge/config.py
ONTOFORGE_DATABASE_URL=postgresql://ontoforge:ontoforge@localhost:5439/ontoforge
# ONTOFORGE_DATABASE_SCHEMA=ontoforge
ONTOFORGE_BASE_IRI=http://ontoforge.local/

# Source warehouse: "postgres" (the registry database, default) or "databricks"
ONTOFORGE_SOURCE_KIND=postgres
# ONTOFORGE_DATABRICKS_HOST=adb-1234567890.12.azuredatabricks.net
# ONTOFORGE_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef1234567890
# ONTOFORGE_DATABRICKS_TOKEN=dapi...
# ONTOFORGE_DATABRICKS_CATALOG=main
# ONTOFORGE_DATABRICKS_SCHEMA=default

# LLM: "none" (default) or "anthropic" (reads ANTHROPIC_API_KEY)
ONTOFORGE_LLM_PROVIDER=none
ONTOFORGE_LLM_MODEL=claude-opus-5

# Auth: "header" trusts an identity header from a reverse proxy (Databricks Apps forwards
# X-Forwarded-Email); "token" requires Authorization: Bearer <api key> issued via /admin/api-keys.
ONTOFORGE_AUTH_MODE=header
ONTOFORGE_AUTH_HEADER=X-Actor
# Role for principals without an explicit one (viewer | builder | reviewer | admin). Keep "viewer" in production.
ONTOFORGE_AUTH_DEFAULT_ROLE=viewer
ONTOFORGE_LOG_FORMAT=text   # text | json (one JSON object per line)
ONTOFORGE_LOG_LEVEL=INFO

# Publish the triple view (and optionally a snapshot table) inside the warehouse: none | view | table
# ONTOFORGE_WAREHOUSE_TARGET_SCHEMA=main.kg
ONTOFORGE_WAREHOUSE_MATERIALIZATION=none

# Optional: manage connections in the Polestar connection module (mf-studio-connectors hub)
# instead of the local table. Connector specs then come from the hub's JSON Schemas and
# secrets never touch datagraph. Leave unset to use the built-in adapters.
# ONTOFORGE_CONNECTIONS_HUB_URL=http://localhost:8000
# One of the hub's CM_SERVICE_TOKENS: lets datagraph open a domain's own connection for browsing and builds
# ONTOFORGE_CONNECTIONS_HUB_SERVICE_TOKEN=
# ONTOFORGE_CONNECTIONS_HUB_TOKEN=<platform user token, if the hub verifies one>

# A build of frontend/ to serve at /ui. Unset: run the vite dev server instead.
# ONTOFORGE_UI_DIR=frontend/dist
