# Copy to deploy/.env and fill in. Never commit the filled copy: it holds credentials.

# -- the registry database (the API's own store: domains, versions, triples) -----------------
ONTOFORGE_DATABASE_URL=postgresql://ontoforge:ontoforge@postgres:5432/ontoforge
# ONTOFORGE_DATABASE_SCHEMA=            # a schema to confine every table to; blank means public

# -- identity -------------------------------------------------------------------------------
# header: the signed-in user arrives in a header, which only a trusted proxy may set.
# token:  callers send an API key. Use this when nothing strips the header from the public.
ONTOFORGE_AUTH_MODE=header
ONTOFORGE_AUTH_HEADER=X-Actor            # Databricks Apps sends X-Forwarded-Email
ONTOFORGE_AUTH_DEFAULT_ROLE=viewer       # the role of anyone without an explicit one

# -- where the mapped tables live -----------------------------------------------------------
ONTOFORGE_SOURCE_KIND=postgres           # postgres | databricks
# ONTOFORGE_DATABRICKS_HOST=
# ONTOFORGE_DATABRICKS_HTTP_PATH=
# ONTOFORGE_DATABRICKS_TOKEN=
# ONTOFORGE_DATABRICKS_CATALOG=
# ONTOFORGE_DATABRICKS_SCHEMA=

# -- where built triples are published, if anywhere ------------------------------------------
ONTOFORGE_WAREHOUSE_MATERIALIZATION=none # none | view | table
# ONTOFORGE_WAREHOUSE_TARGET_SCHEMA=main.ontoforge

# -- the connection module (mf-studio-connectors), which owns every source connection --------
# ONTOFORGE_CONNECTIONS_HUB_URL=http://hub:8025
# ONTOFORGE_CONNECTIONS_HUB_SERVICE_TOKEN=   # lets builds open a domain's connection
# HUB_UPSTREAM=http://hub:8025               # what the UI's nginx proxies /hub/ to

# -- the assistant --------------------------------------------------------------------------
ONTOFORGE_LLM_PROVIDER=none              # none | anthropic | azure_openai
# ONTOFORGE_LLM_MODEL=claude-opus-5
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# -- the interface --------------------------------------------------------------------------
# A build of frontend/ for this API to serve at /ui. Leave it unset when the web image serves
# the app instead; /ui then says where the interface is rather than pretending to be it.
# ONTOFORGE_UI_DIR=/app/ui

# -- operations -----------------------------------------------------------------------------
ONTOFORGE_LOG_FORMAT=json
ONTOFORGE_LOG_LEVEL=INFO
ONTOFORGE_BUILD_WORKERS=2

# -- compose only ---------------------------------------------------------------------------
# POSTGRES_USER=ontoforge
# POSTGRES_PASSWORD=ontoforge
# POSTGRES_DB=ontoforge
# WEB_PORT=8080
# API_IMAGE=registry.example.com/datagraph-api:1.0.0
# WEB_IMAGE=registry.example.com/datagraph-web:1.0.0
