# Which adapter the build talks to. The mock has to be named: anything else reaches the real API,
# so a forgotten setting fails visibly instead of serving design data as though it were real.
VITE_API_MODE=rest
VITE_API_TARGET=http://127.0.0.1:8765

# Who the browser claims to be, for a dev server talking straight to the API. Leave it unset in a
# deployment: the proxy in front sets the identity header and clears whatever a caller sent.
# VITE_ACTOR=alice

# databricks | postgres  (mock mode only; rest mode reads GET /auth/config)
VITE_SOURCE_KIND=databricks

# The connection module (@polestar/connections talks to it directly from the browser).
# Empty: the Configure screen shows the domain's pickers only and says the module is not configured.
# Dev: /hub is proxied to VITE_HUB_TARGET; production: the gateway route, e.g. /api/v1/connection-hub
VITE_CONNECTIONS_URL=/hub
VITE_HUB_TARGET=http://127.0.0.1:8025
